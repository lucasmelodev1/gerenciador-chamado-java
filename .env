DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gerenciador_chamados

# Timezone usado pelo container do banco e da aplicação
APP_TIMEZONE=America/Sao_Paulo

# Segredo usado para assinatura/validação dos tokens JWT
TOKEN=change-me

# Bootstrap do usuário administrador padrão
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_NOME=Administrador
APP_BOOTSTRAP_ADMIN_EMAIL=admin@condominio.local
APP_BOOTSTRAP_ADMIN_SENHA=admin123

# Scheduler de verificação de chamados em atraso
APP_CHAMADO_ATRASO_SCHEDULER_ENABLED=true
APP_CHAMADO_ATRASO_SCHEDULER_INITIAL_DELAY_MS=30000
APP_CHAMADO_ATRASO_SCHEDULER_FIXED_DELAY_MS=60000
