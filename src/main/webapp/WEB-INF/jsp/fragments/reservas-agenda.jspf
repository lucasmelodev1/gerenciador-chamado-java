<%--
    Bloco compartilhado do calendario de reservas (admin e morador).
    Variaveis esperadas: agendaModo (admin|morador), agendaBase, agendaEyebrow, agendaTitulo,
    viewAtual, periodoReferencia, periodoLabel, periodoAnterior, periodoSeguinte, areasFiltro, reservas.
--%>
<section class="card">
    <div class="section-header">
        <div>
            <p class="eyebrow">${agendaEyebrow}</p>
            <h2>${agendaTitulo}</h2>
        </div>
        <a href="${agendaBase}" class="btn btn-secondary">Ver lista</a>
    </div>

    <div class="calendar-toolbar">
        <label class="field">
            <span>Filtrar por area</span>
            <select id="filtro-area">
                <option value="">Todas as areas</option>
                <c:forEach items="${areasFiltro}" var="area">
                    <option value="${area.id}">${fn:escapeXml(area.nome)}</option>
                </c:forEach>
            </select>
        </label>
        <div class="button-row">
            <c:set var="rotuloAnterior" value="${viewAtual eq 'semana' ? 'Semana anterior' : 'Mes anterior'}" />
            <c:set var="rotuloSeguinte" value="${viewAtual eq 'semana' ? 'Proxima semana' : 'Proximo mes'}" />
            <a class="btn btn-secondary" href="${agendaBase}/agenda?inicio=${periodoAnterior}&view=${viewAtual}">${rotuloAnterior}</a>
            <span class="calendar-mes">${periodoLabel}</span>
            <a class="btn btn-secondary" href="${agendaBase}/agenda?inicio=${periodoSeguinte}&view=${viewAtual}">${rotuloSeguinte}</a>
            <span class="calendar-view-toggle">
                <a class="btn ${viewAtual eq 'mes' ? 'btn-primary' : 'btn-secondary'}"
                   href="${agendaBase}/agenda?inicio=${periodoReferencia}&view=mes">Mes</a>
                <a class="btn ${viewAtual eq 'semana' ? 'btn-primary' : 'btn-secondary'}"
                   href="${agendaBase}/agenda?inicio=${periodoReferencia}&view=semana">Semana</a>
            </span>
        </div>
    </div>

    <div id="calendar"
         data-view="${viewAtual}"
         data-referencia="${periodoReferencia}"
         data-base-url="${agendaBase}"
         data-modo="${agendaModo}"></div>

    <div id="reservas-data" class="reservas-data">
        <c:forEach items="${reservas}" var="r">
            <span class="reserva-data"
                  data-id="${r.id}"
                  data-area-id="${r.areaId}"
                  data-start="${r.inicio}"
                  data-end="${r.fim}"
                  data-area="${fn:escapeXml(r.areaNome)}"
                  data-morador="${fn:escapeXml(r.moradorNome)}"
                  data-unidade="${fn:escapeXml(r.unidadeIdentificacao)}"
                  data-status="${fn:escapeXml(r.status)}"
                  data-inicio-formatado="${fn:escapeXml(r.inicioFormatado)}"
                  data-fim-formatado="${fn:escapeXml(r.fimFormatado)}"
                  data-motivo="${fn:escapeXml(r.motivoNegacao)}"></span>
        </c:forEach>
    </div>
</section>

<section id="reserva-detalhe" class="card reserva-detalhe" hidden>
    <div class="section-header">
        <div>
            <p class="eyebrow">Reserva</p>
            <h3 class="reserva-titulo"></h3>
        </div>
        <button type="button" class="btn btn-secondary" id="reserva-fechar">Fechar</button>
    </div>
    <p class="reserva-meta"></p>
    <p class="reserva-motivo"></p>
    <div class="button-row">
        <c:if test="${agendaModo eq 'admin'}">
            <form id="form-aprovar" method="post" hidden>
                <%@ include file="/WEB-INF/jsp/fragments/csrf.jspf" %>
                <input type="hidden" name="_method" value="patch">
                <button type="submit" class="btn btn-primary">Aprovar</button>
            </form>
            <form id="form-negar" method="post" class="inline-panel" hidden>
                <%@ include file="/WEB-INF/jsp/fragments/csrf.jspf" %>
                <input type="hidden" name="_method" value="patch">
                <input type="text" name="motivo" maxlength="255" placeholder="Motivo da negacao" required>
                <button type="submit" class="btn btn-link">Negar</button>
            </form>
        </c:if>
        <form id="form-cancelar" method="post" hidden onsubmit="return confirm('Cancelar esta reserva?');">
            <%@ include file="/WEB-INF/jsp/fragments/csrf.jspf" %>
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="btn btn-link">Cancelar</button>
        </form>
    </div>
</section>
