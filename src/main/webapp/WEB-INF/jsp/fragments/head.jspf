<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${pageTitle} | ${appName}</title>

    <%-- Tailwind CSS 4 + daisyUI 5 (tema "chamados"), gerado por `npm run build:css`
         e pelo estagio `frontend` do Dockerfile. Ver UI-REWRITE-MAP.md §7. --%>
    <link rel="stylesheet" href="${ctx}/css/app.build.css">
    <link rel="stylesheet" href="${ctx}/css/custom.css">

    <%-- LEGADO: mantido durante a transicao (P2..P4). base.css define os tokens usados
         por layout/components/calendar e as telas ainda nao reescritas dependem dessas
         classes; remover agora deixaria ~20 telas sem estilo. Remocao progressiva:
         S10 (components.css) e S17 (base, layout, responsive).
         Ver baseline/EVIDENCE.md > S7. --%>
    <link rel="stylesheet" href="${ctx}/css/base.css">
    <link rel="stylesheet" href="${ctx}/css/layout.css">
    <link rel="stylesheet" href="${ctx}/css/components.css">
    <link rel="stylesheet" href="${ctx}/css/responsive.css">

    <c:if test="${calendarAssets}">
        <link rel="stylesheet" href="${ctx}/css/vendor/fullcalendar/skeleton.min.css">
        <link rel="stylesheet" href="${ctx}/css/vendor/fullcalendar/theme.min.css">
        <link rel="stylesheet" href="${ctx}/css/vendor/fullcalendar/palette.min.css">
        <link rel="stylesheet" href="${ctx}/css/calendar.css">
    </c:if>
</head>
