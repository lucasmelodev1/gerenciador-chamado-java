<%--
    Badge de status de reserva com cor semantica.

    Os quatro estados do enum StatusSolicitacaoArea sao valores fixos, entao o mapeamento
    pode ser literal — o que tambem e obrigatorio para o Tailwind extrair as classes
    (nomes compostos por variavel nao sao detectados; ver UI-REWRITE-MAP.md §4.2).

    Variavel esperada: reservaStatus (definida pelo chamador; removida no fim).
--%>
<c:choose>
    <c:when test="${reservaStatus eq 'Solicitado'}"><span class="badge badge-warning">${reservaStatus}</span></c:when>
    <c:when test="${reservaStatus eq 'Aprovado'}"><span class="badge badge-success">${reservaStatus}</span></c:when>
    <c:when test="${reservaStatus eq 'Negado'}"><span class="badge badge-error">${reservaStatus}</span></c:when>
    <c:otherwise><span class="badge badge-neutral">${reservaStatus}</span></c:otherwise>
</c:choose>
<c:remove var="reservaStatus" />
